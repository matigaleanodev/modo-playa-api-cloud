{
  "name": "modo-playa-api-cloud",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "boundaries": "node scripts/check-boundaries.mjs",
    "privacy": "node scripts/check-privacy.mjs",
    "lint": "oxlint --deny-warnings packages test scripts vitest.config.ts",
    "format": "prettier --ignore-path .gitignore --write .",
    "format:check": "prettier --ignore-path .gitignore --check .",
    "typecheck": "npm run typecheck --workspaces && tsc --noEmit",
    "test": "vitest run",
    "openapi": "npm run openapi --workspace=@modo-playa/contracts",
    "build": "npm run build --workspace=@modo-playa/runtime",
    "synth:local": "npm run synth --workspace=@modo-playa/infrastructure",
    "check": "npm run boundaries && npm run privacy && npm run lint && npm run format:check && npm run typecheck && npm test && npm run openapi && npm run build && npm run synth:local",
    "prepare:media-native": "node scripts/prepare-media-native.mjs"
  },
  "devDependencies": {
    "@modo-playa/contracts": "0.1.0",
    "@modo-playa/infrastructure": "0.1.0",
    "@modo-playa/runtime": "0.1.0",
    "@types/aws-lambda": "8.10.164",
    "@types/node": "24.19.2",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "oxlint": "1.89.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
